# Copy these variables into your local .env file or Vercel Project Settings.
# Never commit real credentials or expose them in frontend JavaScript.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@example.com
SMTP_PASS=your-mailbox-password-or-app-password
CONTACT_TO_EMAIL=info@ybiz.co.za
# Optional; should be an address verified/allowed by your SMTP provider.
MAIL_FROM=your-mailbox@example.com
